'''O programa deve sortear a ordem de apresentação de trabalhos dos alunos.'''

from random import shuffle

# Nome dos alunos

aluno1 = input("Digite o nome do primeiro aluno: ")
aluno2 = input("Digite o nome do segundo aluno: ")
aluno3 = input("Digite o nome do terceiro aluno: ") 
aluno4 = input("Digite o nome do quarto aluno: ")

# Lista e escolha da ordem de apresentação dos alunos

alunos = [aluno1, aluno2, aluno3, aluno4]
shuffle(alunos)  # Embaralha a lista de alunos

# Exibe a ordem de apresentação dos alunos

print(f"A ordem de apresentação dos alunos é: {alunos}")
